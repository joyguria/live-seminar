# 100ms.live Configuration
HMS_TEMPLATE_ID=your_template_id
HMS_ACCESS_KEY=your_access_key
HMS_SECRET=your_hms_app_secret

# JWT Secret for session tokens (REQUIRED — server will not start without it)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server
PORT=3001

# Comma-separated list of allowed CORS origins (React Native clients send no Origin
# header and are always allowed). Example: https://app.example.com,http://localhost:3000
CORS_ORIGINS=

# Firebase Admin SDK — Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your_firebase_project_id
